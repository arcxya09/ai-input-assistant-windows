<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
<EnableWindowsTargeting>true</EnableWindowsTargeting><UseWinUI>true</UseWinUI>
<WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
<WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
<WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
<StartupObject>AiInput.App.Program</StartupObject><AssemblyName>AiInputAssistant</AssemblyName>
<ApplicationManifest>app.manifest</ApplicationManifest>
<ApplicationIcon>Assets/App.ico</ApplicationIcon>
<RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget><SelfContained>true</SelfContained>
<PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed>
</PropertyGroup>
<ItemGroup>
<ProjectReference Include="../AiInput.Core/AiInput.Core.csproj"/>
<ProjectReference Include="../AiInput.Windows/AiInput.Windows.csproj"/>
<ProjectReference Include="../AiInput.DeepSeek/AiInput.DeepSeek.csproj"/>
<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1"/>
<FrameworkReference Include="Microsoft.WindowsDesktop.App"/>
</ItemGroup>
<ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup>
<ItemGroup><Content Include="Assets/App.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
<Target Name="PublishAppPri" AfterTargets="ComputeFilesToPublish">
<Error Condition="'$(ProjectPriFullPath)' == '' Or !Exists('$(ProjectPriFullPath)')" Text="Generated application PRI is missing."/>
<ItemGroup><ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
</Target>
</Project>
